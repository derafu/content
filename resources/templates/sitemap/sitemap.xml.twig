<?xml version="1.0" encoding="UTF-8" ?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for item in items %}
        <url>
            <loc>{{ url(item.route().name, item.route().params) }}</loc>
            <lastmod>{{ item.last_update().format('c') }}</lastmod>
        </url>
    {% endfor %}
</urlset>
