{% extends 'pdf/_layout.pdf.twig' %}
{% set link_urls = {'link_base_url': plugin.context.config.url} %}
{% set pdf_item = page %}

{% block pdf_content %}
    {% if page.isMarkdown %}
        {{ page.data(link_urls) | markdown(has_twig: page.has_twig) }}
    {% else %}
        {{ page.data(link_urls) | twig }}
    {% endif %}
{% endblock %}
