{#
    Macros for the "full" PDF export (?full=1): dump a content item
    together with its whole descendant tree into ONE PDF — Academy
    course → modules → lessons, or Docs/FAQ → children recursively —
    each node on its own page with a <tocentry> feeding the
    <tocpagebreak> table of contents that pdf/_layout.pdf.twig inserts
    at the front when it receives a non-empty `pdf_full_html`.

    Only used by the four templates whose content has a natural tree
    (academy/course, academy/module, docs/show, faq/show). Leaf types
    (academy/lesson, blog/show, pages/show) have no children to dump, so
    they never set `full` and never import this file.
#}
{% trans_default_domain 'content+intl-icu' %}

{#
    Front cover for the "full" export: just the root item's title,
    description, image and meta — no body, no <tocentry> — rendered once,
    before the <tocpagebreak> that pdf/_layout.pdf.twig inserts right
    after it. The root's own content becomes chapter 1 of the tree below,
    where its title appears again as a heading — the same convention a
    printed book follows with its title page vs. Chapter 1.
#}
{#
    Renders a frontmatter "video" (a YouTube URL, already rewritten to its
    embed form by AbstractContentItem::video()) as something a static PDF
    can actually show: a clickable YouTube thumbnail linking to the real
    watch page. Non-YouTube URLs fall back to a plain text link, since
    there is no universal thumbnail convention to rely on for those.
#}
{% macro video(item) %}
    {% set videoUrl = item.video %}
    {% if videoUrl %}
        <div class="pdf-video">
            {% if 'youtube.com/embed/' in videoUrl %}
                {% set videoId = videoUrl | split('/') | last %}
                <a href="https://www.youtube.com/watch?v={{ videoId }}">
                    <img src="https://img.youtube.com/vi/{{ videoId }}/hqdefault.jpg" alt="{{ 'Video: {title}'|trans({'title': item.title}) }}">
                </a>
                <div class="pdf-video-caption">
                    &#9654; <a href="https://www.youtube.com/watch?v={{ videoId }}">{{ 'Watch video'|trans }}</a>
                </div>
            {% else %}
                <div class="pdf-video-caption">
                    &#9654; <a href="{{ videoUrl }}">{{ 'Watch video: {url}'|trans({'url': videoUrl}) }}</a>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{#
    Renders a lesson's self-assessment test ("quiz", AcademyLesson::test())
    as something a static PDF can show: the questions with checkbox-style
    options first (to answer on paper), then an "Answers" section — on
    its own page — with the correct option(s) and explanation for each
    question, mirroring a real printed test booklet.

    Safe to call on ANY item, not just lessons: "item.test is defined"
    no-ops for content types that have no test() method at all (docs,
    faq, courses, modules), so section() below can call this
    unconditionally for every node of a "full" export tree.
#}
{% macro test(item) %}
    {% if item.test is defined and item.test %}
        {% set test = item.test %}
        <div class="pdf-test">
            <h2>{{ test.title }}</h2>
            {% if test.description %}
                <p class="pdf-test-description">{{ test.description }}</p>
            {% endif %}
            {% for question in test.questions %}
                <div class="pdf-test-question">
                    <div class="pdf-test-question-text">{{ loop.index }}. {{ question.text }}</div>
                    {% for option in question.options %}
                        <div class="pdf-test-option">&#9633; {{ option.text }}</div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="pdf-test-answers" style="page-break-before: always;">
            <h2>{{ 'Answers'|trans }}</h2>
            {% for question in test.questions %}
                <div class="pdf-test-answer">
                    <div class="pdf-test-answer-question">{{ loop.index }}. {{ question.text }}</div>
                    <div class="pdf-test-answer-correct">
                        &#10003; {{ question.correctOptions | map(option => option.text) | join(', ') }}
                    </div>
                    {% if question.explanation %}
                        <div class="pdf-test-answer-explanation">{{ question.explanation }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{#
    Renders the properties of a schema (DocsOpenApiView::properties()) as a
    list, each one moved to the right by its depth.
#}
{% macro openapi_properties(rows) %}
    <ul class="pdf-openapi-properties">
        {% for row in rows %}
            <li style="margin-left: {{ row.depth * 14 }}px;">
                <code>{{ row.name }}</code>
                ({{ row.type }}{% if row.required %}, {{ 'required'|trans }}{% endif %}){% if row.description %} — {{ row.description | trim | replace({"\n": ' '}) }}{% endif %}
                {% if row.enum | length > 0 %}<span class="pdf-openapi-note">{{ 'Allowed values: {values}'|trans({'values': row.enum | join(', ')}) }}</span>{% endif %}
                {% if row.default is not null %}<span class="pdf-openapi-note">{{ 'Default: {value}'|trans({'value': row.default}) }}</span>{% endif %}
                {% if row.example is not null %}<span class="pdf-openapi-note">{{ 'Example: {value}'|trans({'value': row.example}) }}</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{#
    Renders the examples of a body (DocsOpenApiView::examples()), each one in a
    block with the media types that have it.
#}
{% macro openapi_examples(examples) %}
    {% for example in examples %}
        <div class="pdf-openapi-example">
            <strong>{% if example.summary %}{{ example.summary }}{% else %}{{ 'Example'|trans }}{% endif %}</strong> ({{ example.types | join(', ') }})
            <pre>{{ example.text }}</pre>
        </div>
    {% endfor %}
{% endmacro %}

{#
    Renders a doc's OpenAPI spec (DocsDoc::openapiView()) as something a
    static PDF can show: the data of the API, how to authenticate, and every
    operation with its parameters, request body and responses, with the
    properties and the examples that the document has — the same information
    the HTML view's interactive Swagger UI widget has, minus the "try it
    out" testing capability a static export cannot offer anyway.

    Safe to call on ANY item, not just docs: "item.openapiView is
    defined" no-ops for content types that have no such method at all
    (academy, blog, faq, pages), so section() below can call this
    unconditionally for every node of a "full" export tree.
#}
{% macro openapi(item) %}
    {% import _self as m %}
    {% if item.openapiView is defined and item.openapiView %}
        {% set view = item.openapiView %}
        {% set spec = item.openapiSpec %}
        <div class="pdf-openapi">
            <h2>{{ spec.info.title }}</h2>
            {% if spec.info.description %}
                <div class="pdf-openapi-description">{{ spec.info.description | markdown }}</div>
            {% endif %}
            {% if spec.info.version %}
                <p class="pdf-openapi-info">{{ 'Version: {version}'|trans({'version': spec.info.version}) }}</p>
            {% endif %}
            {% if spec.info.contact %}
                <p class="pdf-openapi-info">{{ 'Contact: {contact}'|trans({'contact': [spec.info.contact.name, spec.info.contact.email, spec.info.contact.url] | filter(v => v) | join(', ')}) }}</p>
            {% endif %}
            {% if spec.info.license %}
                <p class="pdf-openapi-info">{{ 'License: {license}'|trans({'license': [spec.info.license.name, spec.info.license.url] | filter(v => v) | join(', ')}) }}</p>
            {% endif %}
            {% if spec.info.termsOfService %}
                <p class="pdf-openapi-info">{{ 'Terms of service: {url}'|trans({'url': spec.info.termsOfService}) }}</p>
            {% endif %}
            {% if spec.externalDocumentation %}
                <p class="pdf-openapi-info">{{ 'More information:'|trans }} <a href="{{ spec.externalDocumentation.url }}">{{ spec.externalDocumentation.description ?: spec.externalDocumentation.url }}</a></p>
            {% endif %}
            {% if spec.servers | length > 0 %}
                {% if spec.servers | filter(server => server.description) | length > 0 %}
                    <p class="pdf-openapi-servers">{{ 'Servers:'|trans }}</p>
                    <ul class="pdf-openapi-servers">
                        {% for server in spec.servers %}
                            <li>{{ server.url }}{% if server.description %} — {{ server.description | trim | replace({"\n": ' '}) }}{% endif %}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="pdf-openapi-servers">{{ 'Servers: {servers}'|trans({'servers': spec.servers | map(server => server.url) | join(', ')}) }}</p>
                {% endif %}
            {% endif %}
            {% if spec.securitySchemes | length > 0 %}
                <div class="pdf-openapi-security">
                    <strong>{{ 'Authentication'|trans }}</strong>
                    <ul>
                        {% for name, scheme in spec.securitySchemes %}
                            <li>
                                <code>{{ name }}</code>: {{ scheme.type.value }}{% if scheme.location %} ({{ 'in {location}'|trans({'location': scheme.location.value}) }}{% if scheme.name %}: <code>{{ scheme.name }}</code>{% endif %}){% elseif scheme.scheme %} ({{ scheme.scheme }}{% if scheme.bearerFormat %}, {{ scheme.bearerFormat }}{% endif %}){% elseif scheme.openIdConnectUrl %} ({{ scheme.openIdConnectUrl }}){% endif %}
                                {% if scheme.description %}
                                    <div class="pdf-openapi-parameter-description">{{ scheme.description | markdown }}</div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {% set groups = view.groups %}
            {% if groups | length > 0 %}
                <tocpagebreak name="{{ item.downloadFilename }}-openapi-toc" links="on" toc-preHTML="&lt;h3&gt;{{ 'Index'|trans }}&lt;/h3&gt;" />
            {% endif %}
            {% for group in groups %}
                <div class="pdf-openapi-group">
                    <tocentry
                        content="{{ group.name ?: 'Other'|trans }}"
                        level="0"
                        name="{{ item.downloadFilename }}-openapi-toc"
                    />
                    <h3 class="pdf-openapi-group-title">{{ group.name ?: 'Other'|trans }}</h3>
                    {% if group.description %}
                        <div class="pdf-openapi-group-description">{{ group.description | markdown }}</div>
                    {% endif %}
                    {% for operation in group.operations %}
                        <div class="pdf-openapi-endpoint">
                            <tocentry
                                content="{{ operation.summary ?: (operation.method.value | upper ~ ' ' ~ operation.path) }}"
                                level="1"
                                name="{{ item.downloadFilename }}-openapi-toc"
                            />
                            <div class="pdf-openapi-endpoint-header">
                                <span class="pdf-openapi-method">{{ operation.method.value | upper }}</span>
                                <span class="pdf-openapi-path">{{ operation.path }}</span>
                                {% if operation.deprecated %}<span class="pdf-openapi-deprecated">{{ 'Deprecated'|trans }}</span>{% endif %}
                            </div>
                            {% if operation.summary %}
                                <div class="pdf-openapi-summary">{{ operation.summary }}</div>
                            {% endif %}
                            {% if operation.description %}
                                <div class="pdf-openapi-endpoint-description">{{ operation.description | markdown }}</div>
                            {% endif %}
                            {% if operation.id and operation.id != operation.summary %}
                                <p class="pdf-openapi-info">{{ 'Operation ID: {id}'|trans({'id': operation.id}) }}</p>
                            {% endif %}
                            {% set schemes = operation.acceptedSecuritySchemeNames %}
                            {% if schemes | length > 0 %}
                                <p class="pdf-openapi-info">{{ 'Authentication: {schemes}'|trans({'schemes': schemes | join(', ')}) }}</p>
                            {% endif %}
                            {% if operation.externalDocumentation %}
                                <p class="pdf-openapi-info">{{ 'More information:'|trans }} <a href="{{ operation.externalDocumentation.url }}">{{ operation.externalDocumentation.description ?: operation.externalDocumentation.url }}</a></p>
                            {% endif %}
                            {% if operation.parameters | length > 0 %}
                                <div class="pdf-openapi-parameters">
                                    <strong>{{ 'Parameters'|trans }}</strong>
                                    <ul>
                                        {% for parameter in operation.parameters %}
                                            {% set type = view.typeLabel(parameter.schema) %}
                                            {% set notes = view.parameterNotes(operation, parameter) %}
                                            <li>
                                                <code>{{ parameter.name }}</code>
                                                ({{ parameter.location.value }}{% if type %}, {{ type }}{% endif %}{% if parameter.required %}, {{ 'required'|trans }}{% endif %}{% if parameter.deprecated %}, {{ 'Deprecated'|trans|lower }}{% endif %})
                                                {% if parameter.description %}
                                                    <div class="pdf-openapi-parameter-description">{{ parameter.description | markdown }}</div>
                                                {% endif %}
                                                {% if notes.enum | length > 0 %}<div class="pdf-openapi-note">{{ 'Allowed values: {values}'|trans({'values': notes.enum | join(', ')}) }}</div>{% endif %}
                                                {% if notes.default is not null %}<div class="pdf-openapi-note">{{ 'Default: {value}'|trans({'value': notes.default}) }}</div>{% endif %}
                                                {% for example in notes.examples %}
                                                    <div class="pdf-openapi-note">{% if example.summary %}{{ example.summary }}{% else %}{{ 'Example'|trans }}{% endif %}: <code>{{ example.text }}</code></div>
                                                {% endfor %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                            {% if operation.requestBody %}
                                {% set rows = view.properties(view.schemaOf(operation.requestBody.content)) %}
                                {% set examples = view.examples(operation.requestBody.content) %}
                                <div class="pdf-openapi-request-body">
                                    <strong>{{ 'Request body'|trans }}</strong>{% if operation.requestBody.required %} ({{ 'required'|trans }}){% endif %}
                                    {% if operation.requestBody.description %}
                                        <div class="pdf-openapi-parameter-description">{{ operation.requestBody.description | markdown }}</div>
                                    {% endif %}
                                    {% if operation.requestBody.content | length > 0 %}
                                        <div class="pdf-openapi-note">{{ 'Content types: {types}'|trans({'types': operation.requestBody.content | keys | join(', ')}) }}</div>
                                    {% endif %}
                                    {% if rows | length > 0 %}
                                        {{ m.openapi_properties(rows) }}
                                    {% endif %}
                                    {{ m.openapi_examples(examples) }}
                                </div>
                            {% endif %}
                            {% if operation.responses | length > 0 %}
                                <div class="pdf-openapi-responses">
                                    <strong>{{ 'Responses'|trans }}</strong>
                                    <ul>
                                        {% for status, response in operation.responses %}
                                            {% set rows = view.properties(view.schemaOf(response.content)) %}
                                            {% set examples = view.examples(response.content) %}
                                            <li>
                                                <code>{{ status }}</code>
                                                {% if response.description %}
                                                    <div class="pdf-openapi-response-description">{{ response.description | markdown }}</div>
                                                {% endif %}
                                                {% for name, header in response.headers %}
                                                    <div class="pdf-openapi-note">{{ 'Header'|trans }} <code>{{ name }}</code>{% if header.schema %} ({{ view.typeLabel(header.schema) }}){% endif %}{% if header.description %} — {{ header.description | trim | replace({"\n": ' '}) }}{% endif %}</div>
                                                {% endfor %}
                                                {% if response.content | length > 0 %}
                                                    <div class="pdf-openapi-note">{{ 'Content types: {types}'|trans({'types': response.content | keys | join(', ')}) }}</div>
                                                {% endif %}
                                                {% if rows | length > 0 %}
                                                    {{ m.openapi_properties(rows) }}
                                                {% endif %}
                                                {{ m.openapi_examples(examples) }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
            {% if spec.schemas | length > 0 %}
                <div class="pdf-openapi-group">
                    <tocentry content="{{ 'Schemas'|trans }}" level="0" name="{{ item.downloadFilename }}-openapi-toc" />
                    <h3 class="pdf-openapi-group-title">{{ 'Schemas'|trans }}</h3>
                    {% for name, schema in spec.schemas %}
                        {% set rows = view.properties(schema) %}
                        <div class="pdf-openapi-endpoint">
                            <div class="pdf-openapi-endpoint-header"><span class="pdf-openapi-path">{{ name }}</span></div>
                            {% if schema.description %}
                                <div class="pdf-openapi-endpoint-description">{{ schema.description | markdown }}</div>
                            {% endif %}
                            {% if rows | length > 0 %}
                                {{ m.openapi_properties(rows) }}
                            {% else %}
                                <p class="pdf-openapi-info">{{ view.typeLabel(schema) }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% macro cover(item, kind) %}
    {% import _self as m %}
    {% if kind %}
        <div class="pdf-breadcrumb">{{ kind }}</div>
    {% endif %}

    <div class="pdf-title">{{ item.title }}</div>

    {% if item.description %}
        <div class="pdf-description">{{ item.description }}</div>
    {% endif %}

    {% if item.image %}
        <div class="pdf-cover-image">
            <img src="{{ item.image }}" alt="{{ item.title }}">
        </div>
    {% endif %}

    {{ m.video(item) }}

    <div class="pdf-meta">
        {% if item.authors | length > 0 %}{{ item.authors | join(', ') }} &middot; {% endif %}
        {{ item.date | date('d/m/Y') }}
        {% if item.tags | length > 0 %}
            &middot; {{ item.tags | map(tag => '#' ~ tag.slug) | join(', ') }}
        {% endif %}
    </div>

    {% if item.deprecated %}
        <div class="pdf-warning">
            {{ 'This content is deprecated since {date}. It\'s not recommended to use this content anymore.'|trans({'date': item.deprecatedAt | date('d/m/Y')}) }}
        </div>
    {% endif %}
{% endmacro %}

{% macro section(item, kind, level, link_urls) %}
    {% import _self as m %}
    <div{% if level > 0 %} style="page-break-before: always;"{% endif %}>
        <tocentry content="{{ item.title }}" level="{{ level }}" name="toc" />

        {% if kind or item.ancestors | length > 0 %}
            <div class="pdf-breadcrumb">
                {% if kind %}{{ kind }}{% endif %}
                {% for ancestor in item.ancestors %}
                    &raquo; {{ ancestor.title }}
                {% endfor %}
                &raquo; {{ item.title }}
            </div>
        {% endif %}

        <div class="{{ level > 0 ? 'pdf-subtitle' : 'pdf-title' }}">{{ item.title }}</div>

        {% if item.description %}
            <div class="pdf-description">{{ item.description }}</div>
        {% endif %}

        {% if item.image %}
            <div class="pdf-cover-image">
                <img src="{{ item.image }}" alt="{{ item.title }}">
            </div>
        {% endif %}

        {{ m.video(item) }}

        <div class="pdf-meta">
            {% if item.authors | length > 0 %}{{ item.authors | join(', ') }} &middot; {% endif %}
            {{ item.date | date('d/m/Y') }}
            {% if item.tags | length > 0 %}
                &middot; {{ item.tags | map(tag => '#' ~ tag.slug) | join(', ') }}
            {% endif %}
        </div>

        {% if item.deprecated %}
            <div class="pdf-warning">
                {{ 'This content is deprecated since {date}. It\'s not recommended to use this content anymore.'|trans({'date': item.deprecatedAt | date('d/m/Y')}) }}
            </div>
        {% endif %}

        {% if item.data %}
            {% if item.isMarkdown %}
                {{ item.data(link_urls) | markdown(has_twig: item.has_twig) }}
            {% else %}
                {{ item.data(link_urls) | twig }}
            {% endif %}
        {% else %}
            {{ ('# ' ~ item.title) | markdown }}
        {% endif %}

        {{ m.test(item) }}
        {{ m.openapi(item) }}

        <div class="pdf-footer-meta">
            {{ 'Last updated on {date}'|trans({'date': item.last_update | date('d/m/Y')}) }}
        </div>
    </div>
{% endmacro %}

{% macro tree(item, kind, level, link_urls) %}
    {% import _self as m %}
    {{ m.section(item, kind, level, link_urls) }}
    {% for child in item.children %}
        {{ m.tree(child, kind, level + 1, link_urls) }}
    {% endfor %}
{% endmacro %}

{% macro academy_module(module, kind, level, link_urls) %}
    {% import _self as m %}
    {{ m.section(module, kind, level, link_urls) }}
    {% for lesson in module.lessons %}
        {{ m.section(lesson, kind, level + 1, link_urls) }}
    {% endfor %}
{% endmacro %}

{% macro academy_course(course, kind, link_urls) %}
    {% import _self as m %}
    {{ m.section(course, kind, 0, link_urls) }}
    {% for module in course.modules %}
        {{ m.academy_module(module, kind, 1, link_urls) }}
    {% endfor %}
{% endmacro %}
