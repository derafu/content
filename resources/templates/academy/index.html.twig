{% extends 'layouts/academy.html.twig' %}
{% trans_default_domain 'content+intl-icu' %}

{% block title %}{{ 'Academy'|trans }}{% endblock %}

{% block academy_header %}
    {% set academyIntro = '<h3>Need to learn something?</h3><p>Here you will find courses, trainings and certifications associated with our products.</p><p>Do you want to learn about a topic? Start a course with us!</p>'|trans %}
    <section id="hero">
        <twig:block-hero
            size="small"
            background="/img/content/academy/academy-cover.png"
            title="{{ 'Academy'|trans }}"
            subtitle="{{ academyIntro }}"
            align="left"
        />
    </section>
{% endblock %}

{% block academy_content %}
    <section id="courses" class="my-4">
        <twig:block-title
            class="container"
            align="left"
            title="{{ 'Our courses'|trans }}"
            subtitle="{{ 'Explore our courses and start learning today!'|trans }}"
        />

        <div class="container">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for course in courses %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            {% if course.image %}
                                <a href="{{ path('academy_course', {'course': course.slug}) }}">
                                    <img src="{{ course.image }}" class="card-img-top" alt="{{ course.title }}">
                                </a>
                            {% endif %}
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="{{ path('academy_course', {'course': course.slug}) }}" class="text-decoration-none">
                                        {{ course.title }}
                                    </a>
                                </h5>
                                <p class="card-text text-muted">{{ course.description }}</p>
                                {% for tag in course.tags %}
                                    <a href="{{ path('academy_tag', {'tag': tag.slug}) }}" class="badge bg-secondary text-decoration-none">
                                        {{ tag.name }}
                                    </a>
                                {% endfor %}
                            </div>
                            <div class="card-footer d-flex justify-content-between text-muted small">
                                <span>
                                    {{ course.time_formatted }}
                                </span>
                                {% set lessonsCount = course.lessons|length %}
                                <span>{{ '{count, plural, one {{n} lesson} other {{n} lessons}}'|trans({'count': lessonsCount, 'n': lessonsCount}) }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
