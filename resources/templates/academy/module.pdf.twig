{% extends 'pdf/_layout.pdf.twig' %}
{% import 'pdf/_macros.pdf.twig' as pdf %}
{% set link_urls = {'link_base_url': plugin.context.config.url} %}
{% set pdf_item = module %}
{% set pdf_kind = 'Academy' %}

{% if full and module.lessons | length > 0 %}
    {% set pdf_full_html %}
        {{ pdf.academy_module(module, pdf_kind, 0, link_urls) }}
    {% endset %}
{% endif %}

{% block pdf_content %}
    {% if not module.data %}
        {{ ('# ' ~ module.title) | markdown }}
    {% else %}
        {{ module.data(link_urls) | markdown(has_twig: module.has_twig) }}
    {% endif %}
{% endblock %}

{% block pdf_hierarchy %}
    {% if module.lessons | length > 0 %}
        <div class="pdf-hierarchy">
            <h2>Lessons</h2>
            <ul>
                {% for lesson in module.lessons %}
                    <li>
                        {{ lesson.title }}
                        <span class="pdf-time">({{ lesson.time_formatted }})</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
