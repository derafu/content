{% extends 'pdf/_layout.pdf.twig' %}
{% import 'pdf/_macros.pdf.twig' as pdf %}
{% set link_urls = {'link_base_url': plugin.context.config.url} %}
{% set pdf_item = course %}
{% set pdf_kind = 'Academy' %}

{% if full and course.modules | length > 0 %}
    {% set pdf_full_html %}
        {{ pdf.academy_course(course, pdf_kind, link_urls) }}
    {% endset %}
{% endif %}

{% block pdf_content %}
    {{ course.data(link_urls) | markdown(has_twig: course.has_twig) }}
{% endblock %}

{% block pdf_hierarchy %}
    {% if course.modules | length > 0 %}
        <div class="pdf-hierarchy" style="page-break-before: always;">
            <h2>Modules</h2>
            {% for module in course.modules %}
                <div class="pdf-hierarchy-module">
                    <div class="pdf-hierarchy-module-title">{{ loop.index }}. {{ module.title }}</div>
                    <ul>
                        {% for lesson in module.lessons %}
                            <li>
                                {{ lesson.title }}
                                <span class="pdf-time">({{ lesson.time_formatted }})</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
