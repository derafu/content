{% extends 'pdf/_layout.pdf.twig' %}
{% import 'pdf/_macros.pdf.twig' as pdf %}
{% set link_urls = {'link_base_url': plugin.context.config.url} %}
{% set pdf_item = doc %}
{% set pdf_kind = 'Docs' %}

{% if full and doc.children | length > 0 %}
    {% set pdf_full_html %}
        {{ pdf.tree(doc, pdf_kind, 0, link_urls) }}
    {% endset %}
{% endif %}

{% block pdf_content %}
    {% if doc.isMarkdown %}
        {{ doc.data(link_urls) | markdown(has_twig: doc.has_twig) }}
    {% else %}
        {{ doc.data(link_urls) | twig }}
    {% endif %}
    {{ pdf.openapi(doc) }}
{% endblock %}

{% block pdf_hierarchy %}
    {% if doc.children | length > 0 %}
        <div class="pdf-hierarchy">
            <h2>Pages in this section</h2>
            <ul>
                {% for child in doc.children %}
                    <li>
                        <strong>{{ child.title }}</strong>
                        {% if child.description %} — {{ child.description }}{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
