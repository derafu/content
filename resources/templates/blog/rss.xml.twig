<?xml version="1.0" encoding="UTF-8" ?>
{% trans_default_domain 'content+intl-icu' %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ (feed.title ?? 'Blog of {site}'|trans({'site': plugin.context.config.title}))|e('html') }}</title>
        <link>{{ url('blog')|e('html') }}</link>
        <atom:link href="{{ url('blog_rss') }}" rel="self" type="application/rss+xml" />
        <description>{{ (feed.description ?? 'Insights & Updates: Thoughts, stories, and the latest from our world.'|trans)|e('html') }}</description>
        {% if feed.language ?? false %}
        <language>{{ feed.language|e('html') }}</language>
        {% endif %}
        {% if feed.copyright ?? false %}
        <copyright>{{ feed.copyright|e('html') }}</copyright>
        {% endif %}
        {% if feed.lastBuildDate ?? false %}
        <lastBuildDate>{{ feed.lastBuildDate.format('r') }}</lastBuildDate>
        {% endif %}
        {% for post in posts %}
            <item>
                <title>{{ post.title()|e('html') }}</title>
                <link>{{ url('blog_post', { post: post.uri() }) }}</link>
                <guid isPermaLink="true">{{ url('blog_post', { post: post.uri() }) }}</guid>
                <pubDate>{{ post.date().format('r') }}</pubDate>
                <description><![CDATA[{{ post.data()|markdown|raw }}]]></description>
            </item>
        {% endfor %}
    </channel>
</rss>
