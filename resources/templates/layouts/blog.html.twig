{% extends 'layouts/default.html.twig' %}
{% trans_default_domain 'content+intl-icu' %}

{% block title %}{{ blog.title | default('Blog'|trans) }}{% endblock %}

{% block content %}

{% block blog_header %}{% endblock %}

<section id="posts" class="container my-4">
    <div class="row">
        <div class="col-md-8">
            {% block blog_content %}{% endblock %}
        </div>
        <div class="col-md-4">
            {% block blog_sidebar %}{% endblock %}

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Latest Posts'|trans }}</h5>
                </div>
                <div class="list-group list-group-flush">
                    {% for post in recentPosts %}
                        <a href="{{ path('blog_post', {'post': post.uri}) }}" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">{{ post.title }}</h6>
                            </div>
                            <small class="text-muted">
                                {{ 'By {authors} on {date} • {time} min read.'|trans({
                                    'authors': post.authors | join(', '),
                                    'date': post.date | date('d/m/Y'),
                                    'time': post.time,
                                }) }}
                            </small>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Tags'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        {% for tag in tags %}
                            <a href="{{ path('blog_tag', {'tag': tag.slug}) }}" class="btn btn-outline-secondary btn-sm">
                                {{ tag.name }}
                                <span class="badge bg-secondary ms-1">{{ tag.count }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">{{ 'Archives'|trans }}</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        {% for archive in archives %}
                            <a href="{{ path('blog_archive', {'archive': archive.slug}) }}" class="btn btn-outline-secondary btn-sm">
                                {{ archive.name }}
                                <span class="badge bg-secondary ms-1">{{ archive.count }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}

{% block blog_footer %}{% endblock %}
