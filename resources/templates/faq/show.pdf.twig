{% extends 'pdf/_layout.pdf.twig' %}
{% import 'pdf/_macros.pdf.twig' as pdf %}
{% set link_urls = {'link_base_url': plugin.context.config.url} %}
{% set pdf_item = faq %}
{% set pdf_kind = 'FAQ' %}

{% if full and faq.children | length > 0 %}
    {% set pdf_full_html %}
        {{ pdf.tree(faq, pdf_kind, 0, link_urls) }}
    {% endset %}
{% endif %}

{% block pdf_content %}
    {{ faq.data(link_urls) | markdown(has_twig: faq.has_twig) }}
{% endblock %}

{% block pdf_hierarchy %}
    {% if faq.children | length > 0 %}
        <div class="pdf-hierarchy">
            <h2>Related questions</h2>
            <ul>
                {% for child in faq.children %}
                    <li>{{ child.title }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
